generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== فروشگاه اینترنتی نان بستنی آرتا =====
// مستقل از Waffly ولی با نام فیلدهای همخوان برای مهاجرت آینده

model Product {
  id             String  @id
  slug           String  @unique
  name           String
  sizeLabel      String // کوچک / متوسط / بزرگ / کاسه‌ای
  pricePerUnit   Int // تومان — قیمت خرده هر عدد
  unitsPerBox    Int     @default(200)
  essenceEnabled Boolean @default(true)
  imageUrl       String  @default("")
  description    String?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
}

model Essence {
  id     String  @id
  name   String // «اسانس پرتقال» — افزودن طعم جدید = فقط یک ردیف جدید
  active Boolean @default(true)
}

model Province {
  id           String @id
  name         String @unique
  shippingCost Int // تومان — از مبدأ تولید
}

model Order {
  id            String   @id @default(cuid())
  serial        Int      @unique // شماره سریال فاکتور — ۱۰۰۱ به بعد
  customerName  String
  phone         String
  provinceName  String
  cityName      String
  address       String
  postalCode    String?
  note          String?
  items         String // JSON — OrderItemDTO[]
  subtotal      Int
  shippingCost  Int
  total         Int
  paymentMethod String   @default("ON_DELIVERY") // ON_DELIVERY | CARD_TRANSFER | (آینده: ONLINE)
  status        String   @default("PENDING") // PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([status])
}

model OrderCounter {
  id         String @id @default("main")
  lastNumber Int    @default(1000)
}

model Setting {
  key   String @id
  value String
}
